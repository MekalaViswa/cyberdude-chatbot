# Copy this file to .env and fill in your real values. Never commit .env.
# No AI API key needed — this bot answers using keyword search over the
# crawled site content, not a language model.

# The exact origin(s) allowed to call this API (your live website).
# Comma-separate multiple origins if needed, e.g. for a staging domain too.
# Add "null" only for local testing (opening widget/test.html directly as a
# file:// page sends Origin: null) — remove it once you deploy for real.
ALLOWED_ORIGINS=https://cyberdudenetworks.com,https://www.cyberdudenetworks.com

# Port the server listens on
PORT=3000

# Max chat messages allowed per IP per minute (basic abuse guardrail)
RATE_LIMIT_PER_MINUTE=30
